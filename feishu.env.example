# 飞书网关配置示例：把需要的行复制到项目根 .env
# 配置检查：python src/feishu_gateway.py --check

# 开放平台 →「凭证与基础信息」
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API 与网关共用同一个令牌（随意字符串，两端一致即可）
HARNESS_API_TOKEN=change-me

# 允许使用机器人的人（open_id，逗号分隔）。
# 不知道自己的 ID：先注释掉这一行启动，给机器人发消息，它会回你一行可用配置。
FEISHU_ALLOWED_USERS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 仅本机测试：放开白名单（机器人背后是本机 shell，不要在生产开启）
# FEISHU_ALLOW_ANY_USER=1

# API 地址（网关与 API 不在同一台机器时修改）
# HARNESS_API_URL=http://127.0.0.1:8000

# 回复卡片：schema 2.0 过程卡（默认开）。客户端不支持可设 0 退回 Markdown 卡
# FEISHU_STEP_CARD=0

# 回合通知（watcher）
# FEISHU_WATCH_POLL=1.0
# FEISHU_WATCH_STALLED=300
# FEISHU_WATCH_STATE=.cache/turn_watch.json
